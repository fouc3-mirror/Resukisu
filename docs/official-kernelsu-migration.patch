@@ -0,0 +1,156 @@
+# ========================================
+# 单版本 AK3 打包入口
+# ========================================
+# 只编译一个 Android/内核版本组合，最终只上传 AnyKernel3 压缩包，
+# 适合按机型参数（设置 → 关于手机 → 内核版本）快速出包。
+#
+# 示例：内核显示 6.6.118-android15-8-g0908354dac1b
+#   → android_version = android15
+#   → kernel_version  = 6.6
+#   → sub_level       = 118
+# ========================================
+
+name: 单版本 AK3 打包
+
+permissions:
+  contents: write
+  actions: write
+
+on:
+  workflow_dispatch:
+    inputs:
+      android_version:
+        description: "Android 版本"
+        required: true
+        type: choice
+        options:
+          - android12
+          - android13
+          - android14
+          - android15
+          - android16
+        default: android15
+      kernel_version:
+        description: "内核版本"
+        required: true
+        type: choice
+        options:
+          - "5.10"
+          - "5.15"
+          - "6.1"
+          - "6.6"
+          - "6.12"
+        default: "6.6"
+      sub_level:
+        description: "子版本号 (内核版本里的第三段，如 6.6.118 → 118)"
+        required: true
+        type: string
+        default: "118"
+      os_patch_level:
+        description: "安全补丁级别 (如 2026-01, lts)"
+        required: true
+        type: string
+        default: "2026-01"
+      revision:
+        description: "修订版本 (如 r11, 仅 Android 12 - 5.10 需要)"
+        required: false
+        type: string
+        default: ""
+      use_zram:
+        description: "启用 ZRAM 增强算法 (LZ4KD)"
+        required: false
+        type: boolean
+        default: false
+      use_bbg:
+        description: "启用 BBG 防格机"
+        required: false
+        type: boolean
+        default: true
+      supp_op:
+        description: "添加一加 8E 处理器支持"
+        required: false
+        type: boolean
+        default: false
+
+jobs:
+  # ==================== 预检 ====================
+  # 先确认 ACK 分支存在，避免白跑一次 30 分钟的编译
+  preflight:
+    name: "预检 ${{ inputs.android_version }}-${{ inputs.kernel_version }}-${{ inputs.os_patch_level }}"
+    runs-on: ubuntu-latest
+    steps:
+      - name: 校验 ACK 分支
+        run: |
+          BRANCH="${{ inputs.android_version }}-${{ inputs.kernel_version }}-${{ inputs.os_patch_level }}"
+          echo "检查 android.googlesource.com/kernel/common 分支: $BRANCH"
+          if git ls-remote --exit-code --heads \
+              https://android.googlesource.com/kernel/common "$BRANCH" >/dev/null 2>&1; then
+            echo "分支存在: $BRANCH"
+          else
+            echo "::error::ACK 分支不存在: $BRANCH ，请检查 android_version / kernel_version / os_patch_level"
+            exit 1
+          fi
+
+  # ==================== 编译内核 ====================
+  build:
+    name: "${{ inputs.android_version }}-${{ inputs.kernel_version }}.${{ inputs.sub_level }}"
+    needs: preflight
+    uses: ./.github/workflows/build.yml
+    secrets: inherit
+    with:
+      android_version: ${{ inputs.android_version }}
+      kernel_version: ${{ inputs.kernel_version }}
+      sub_level: ${{ inputs.sub_level }}
+      os_patch_level: ${{ inputs.os_patch_level }}
+      revision: ${{ inputs.revision }}
+      use_zram: ${{ inputs.use_zram }}
+      use_bbg: ${{ inputs.use_bbg }}
+      supp_op: ${{ inputs.supp_op }}
+      enable_susfs: true
+
+  # ==================== 只保留 AK3 包 ====================
+  package-ak3:
+    name: "打包 AK3"
+    needs: build
+    runs-on: ubuntu-latest
+    steps:
+      - name: 下载构建产物
+        uses: actions/download-artifact@v4
+        with:
+          pattern: 'KernelSU_kernel-*'
+          path: ./artifacts
+          merge-multiple: true
+
+      - name: 筛选 AnyKernel3 压缩包
+        run: |
+          mkdir -p ak3
+          find ./artifacts -type f -name '*AnyKernel3.zip' -exec cp -v {} ./ak3/ \;
+          COUNT=$(find ./ak3 -type f -name '*.zip' | wc -l)
+          if [ "$COUNT" -eq 0 ]; then
+            echo "::error::没有找到 AnyKernel3 压缩包，构建可能未生成 Image"
+            exit 1
+          fi
+          echo "找到 $COUNT 个 AK3 包"
+          ls -l ./ak3
+
+      - name: 上传 AK3 包
+        uses: actions/upload-artifact@v4
+        with:
+          name: AK3-${{ inputs.android_version }}-${{ inputs.kernel_version }}.${{ inputs.sub_level }}-${{ inputs.os_patch_level }}
+          path: ./ak3/*.zip
+          if-no-files-found: error
+          compression-level: 0
+
+      - name: 摘要
+        run: |
+          {
+            echo "## AK3 打包完成"
+            echo ""
+            echo "- Android: ${{ inputs.android_version }}"
+            echo "- 内核: ${{ inputs.kernel_version }}.${{ inputs.sub_level }}"
+            echo "- 补丁级别: ${{ inputs.os_patch_level }}"
+            echo "- SUSFS: 已启用"
+            echo "- KPM: 未集成"
+            echo ""
+            echo "下载 artifact: \`AK3-${{ inputs.android_version }}-${{ inputs.kernel_version }}.${{ inputs.sub_level }}-${{ inputs.os_patch_level }}\`"
+          } >> $GITHUB_STEP_SUMMARY
